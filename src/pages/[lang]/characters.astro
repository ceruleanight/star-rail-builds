---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CharacterPlanner from '../../components/CharacterPlanner.astro';

import '../../styles/base.css';
import '../../styles/home.css';
import '../../styles/theme.css';
import '../../styles/roster.css';
import '../../styles/characters.css';

import { getCharacterPlanData } from '../../utils/character-plans';
import { getLocale, t } from '../../utils/i18n';
import { localizedPath, sitePath } from '../../utils/paths';
import { getLanguageStaticPaths } from '../../utils/routes';

export const getStaticPaths = getLanguageStaticPaths;
const lang = Astro.params.lang ?? 'en';
const locale = getLocale(lang);
const title = t(locale, 'ui', 'My Characters');
const characters = getCharacterPlanData(lang);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href={sitePath('favicon.ico')} />
        <title>{title} - Star Rail Builds</title>
    </head>
    <body data-type="base" class="browser-background">
        <Header locale={locale} lang={lang} page="characters" />
        <main class="plan-page">
            <h1>{title}</h1>
            <CharacterPlanner {characters} {locale} relicsHref={localizedPath(lang, 'relics')} />
        </main>
        <Footer {lang} />
    </body>
</html>
