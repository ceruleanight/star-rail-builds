---
import { Image } from 'astro:assets';
import { t, type getLocale } from '../utils/i18n';
import type { getRelicSetBrowserData } from '../utils/relic-browser';

interface Props {
    data: ReturnType<typeof getRelicSetBrowserData>;
    locale: ReturnType<typeof getLocale>;
    charactersHref: string;
}

const { data, locale, charactersHref } = Astro.props;
const ui = (id: string) => t(locale, 'ui', id);

const allLabel = t(locale, 'ui', 'All');

const resultsLabel = t(locale, 'ui', 'Results');

const noResultsLabel = t(locale, 'ui', 'No relic sets found', undefined, false);

const searchByNameLabel = t(locale, 'ui', 'Search by name');

const searchLabel = t(locale, 'ui', 'Search');

const typeLabel = t(locale, 'ui', 'Relic Type', undefined, false);

const cavernLabel = t(locale, 'ui', 'Cavern Relics', undefined, false);

const planarLabel = t(locale, 'ui', 'Planar Ornaments', undefined, false);

const tagLabel = t(locale, 'ui', 'Set Effect', undefined, false);

const sortByLabel = t(locale, 'ui', 'Sort by');

const releaseDateLabel = t(locale, 'ui', 'Release Date');

const newestLabel = t(locale, 'ui', 'Newest');

const relicSetsLabel = t(locale, 'ui', 'Relic Sets', undefined, false);

const sortOptions = [
    {
        value: 'name',
        label: t(locale, 'ui', 'Relic Sets - A-Z', undefined, false),
    },
    {
        value: 'release',
        label: t(locale, 'ui', 'Release Date - Newest', undefined, false),
    },
];

const relicSetFilterSortOptions = [
    {
        value: 'release',
        label: t(locale, 'ui', 'Release Date - Newest', undefined, false),
    },
    {
        value: 'name',
        label: t(locale, 'ui', 'Relic Sets - A-Z', undefined, false),
    },
    {
        value: 'type',
        label: typeLabel,
    },
];

const noMentionsLabel = t(locale, 'ui', 'No relic set mentions', undefined, false);

const previewLabel = t(locale, 'ui', 'Preview', undefined, false);

const getRankedOnLabel = (pieces: number) =>
    t(locale, 'ui', `${pieces}-Piece ranked on`, undefined, false);

const getTypeLabel = (type: 'cavern' | 'planar') =>
    type === 'cavern' ? cavernLabel : planarLabel;
---

<section class="artifact-set-browser" data-relic-browser>
    <div
        class="roster-panel relic-roster-bar"
        data-relic-roster
        data-defaults={JSON.stringify(data.characterDefaults)}
        data-no-characters={ui('Roster no characters')}
        data-not-needed={ui('Roster not needed')}
        data-label-two={ui('2-Pc')}
        data-label-four={ui('4-Pc')}
        data-all-substats={JSON.stringify(data.allSubstats)}
        data-label-substats-needed={ui('Roster substats needed')}
        data-label-substats-ignored={ui('Roster substats ignored')}
    >
        <div class="roster-toolbar">
            <p>{ui('Roster selected')} <strong data-roster-count aria-live="polite">0</strong></p>
            <a href={charactersHref}>{ui('Plan edit')}</a>
        </div>
        <div class="roster-toolbar">
            <div class="roster-chips" role="group" aria-label={ui('Roster view')}>
                {[['needed', 'Roster keep'], ['unneeded', 'Roster remove'], ['', 'All']].map(([value, label]) => (
                    <button class="roster-button" type="button" data-relic-view={value} aria-pressed={value === '' ? 'true' : 'false'}>
                        {ui(label)} <span data-view-count></span>
                    </button>
                ))}
            </div>
            <label class="roster-sort">
                {ui('Roster stats shown')}
                <select class="home-native-select" data-relic-stat-mode>
                    <option value="all">{ui('Roster stats all')}</option>
                    <option value="top">{ui('Roster stats top')}</option>
                </select>
            </label>
            <label class="roster-checkbox">
                <input type="checkbox" data-relic-hide-names /> {ui('Roster hide names')}
            </label>
            <label class="roster-checkbox">
                <input type="checkbox" data-relic-hide-ranked /> {ui('Roster hide ranked')}
            </label>
        </div>
        <select name="roster" form="relic-set-filters" data-relic-roster-filter hidden>
            <option value=""></option>
            <option value="needed"></option>
            <option value="unneeded"></option>
        </select>
    </div>
    <form
        class="home-filters artifact-set-filters"
        id="relic-set-filters"
        data-relic-filters
    >
        <label class="home-search">
            {searchLabel}

            <input
                type="search"
                name="search"
                placeholder={searchByNameLabel}
                autocomplete="off"
            />
        </label>

        <label class="home-search">
            {ui('Roster search')}

            <input
                type="search"
                name="character"
                data-relic-character-search
                placeholder={ui('Roster search')}
                autocomplete="off"
            />
        </label>

        <div class="home-select-filter">
            {typeLabel}

            <select
                class="home-native-select"
                name="type"
                aria-label={typeLabel}
            >
                <option value="">
                    {allLabel}
                </option>

                <option value="cavern">
                    {cavernLabel}
                </option>

                <option value="planar">
                    {planarLabel}
                </option>
            </select>
        </div>

        <div class="home-select-filter">
            {tagLabel}

            <select
                class="home-native-select"
                name="tagGroups"
                aria-label={tagLabel}
            >
                <option value="">
                    {allLabel}
                </option>

                {
                    data.tagOptionGroups.map((group) => (
                        <optgroup label={group.label}>
                            {group.options.map((tag) => (
                                <option value={tag.id}>{tag.label}</option>
                            ))}
                        </optgroup>
                    ))
                }
            </select>
        </div>

        <details class="artifact-set-set-filter" data-relic-set-filter>
            <summary>{relicSetsLabel}</summary>
            <div class="artifact-set-set-filter-actions">
                <button type="button" class="roster-button" data-relic-sets-select-all>
                    {allLabel}
                </button>
                <button type="button" class="roster-button" data-relic-sets-clear>
                    {ui('Roster clear')}
                </button>
                <label class="roster-sort artifact-set-filter-sort">
                    {sortByLabel}
                    <select class="home-native-select" name="setSort" data-relic-set-sort>
                        {relicSetFilterSortOptions.map((option) => (
                            <option value={option.value} selected={option.value === 'release'}>
                                {option.label}
                            </option>
                        ))}
                    </select>
                </label>
            </div>
            <div
                class="artifact-set-set-options"
                data-relic-set-options
                role="group"
                aria-label={relicSetsLabel}
            >
                {data.relicSets.map(({ id, name, image, type, versionReleased }) => (
                    <button
                        type="button"
                        class="artifact-set-set-option"
                        data-relic-set-filter-item
                        data-set-id={id}
                        data-set-name={name}
                        data-set-type={type}
                        data-version-released={versionReleased}
                        aria-pressed="true"
                    >
                        {image && (
                            <Image
                                src={image}
                                alt=""
                                width={56}
                                height={56}
                                loading="lazy"
                                decoding="async"
                            />
                        )}
                        <span>{name}</span>
                    </button>
                ))}
            </div>
        </details>
    </form>

    <div class="artifact-set-browser-header">
        <p
            data-relic-count
            data-results-label={resultsLabel}
            aria-live="polite"
        >
            {data.relicSets.length}
            {' '}
            {resultsLabel}
        </p>

        <label class="roster-sort">
            {sortByLabel}

            <select
                class="home-native-select"
                name="sort"
                form="relic-set-filters"
                aria-label={sortByLabel}
            >
                {
                    sortOptions.map((option) => (
                        <option
                            value={option.value}
                            selected={option.value === 'name'}
                        >
                            {option.label}
                        </option>
                    ))
                }
            </select>
        </label>
    </div>

    <div class="artifact-set-grid">
        {
            data.relicSets.map((relicSet) => (
                <article
                    class={`artifact-set-entry rarity-${relicSet.rarity}`}
                    data-relic-card
                    data-set-id={relicSet.id}
                    data-usage-json={JSON.stringify(relicSet.ownedUsage)}
                    data-name={relicSet.name}
                    data-type={relicSet.type}
                    data-tags={relicSet.tags.join(' ')}
                    data-tag-groups={relicSet.tagGroups.join(' ')}
                    data-version-released={relicSet.versionReleased}
                >
                    <header class="artifact-set-entry-header">
                        <div class="artifact-set-entry-title">
                            <div
                                class={`artifact-set-entry-image${
                                    relicSet.image ? '' : ' is-empty'
                                }`}
                            >
                                {relicSet.image && (
                                    <Image
                                        src={relicSet.image}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        width={72}
                                        height={72}
                                        densities={[1, 2]}
                                    />
                                )}
                            </div>

                            <div>
                                <h2>{relicSet.name}</h2>

                                <span>{getTypeLabel(relicSet.type)}</span>
                            </div>
                        </div>

                        <span class="artifact-set-entry-rarity">
                            {relicSet.rarity}
                            {'\u2605'}
                        </span>
                    </header>

                    <div class="artifact-set-bonus-list">
                        {relicSet.bonuses.map((bonus) => (
                            <section
                                class="artifact-set-bonus"
                                aria-label={`${relicSet.name} ${bonus.label}`}
                            >
                                <h3>{bonus.label}</h3>

                                <div set:html={bonus.html} />
                            </section>
                        ))}
                    </div>

                    <section
                        class="artifact-set-usage"
                        aria-label={`${relicSet.name} ${getRankedOnLabel(relicSet.usagePieces)}`}
                    >
                        <h3>{getRankedOnLabel(relicSet.usagePieces)}</h3>

                        {relicSet.rankedOn.length > 0 ? (
                            <div class="artifact-set-usage-list">
                                {relicSet.rankedOn.map((usage) => (
                                    <span class="artifact-set-usage-item">
                                        <a
                                            class={`artifact-set-usage-chip character-rarity-${usage.characterRarity}${
                                                usage.isWip ? ' is-wip' : ''
                                            }${usage.popoverHtml ? ' has-preview' : ''}`}
                                            href={usage.href}
                                            data-usage-popover-html={
                                                usage.popoverHtml || undefined
                                            }
                                        >
                                            {(usage.rank || usage.isWip) && (
                                                <strong class="usage-rank-number">
                                                    {usage.isWip ? 'WIP' : usage.rank}
                                                </strong>
                                            )}
                                            <span class="artifact-set-usage-character">
                                                {usage.characterName}
                                            </span>
                                        </a>
                                        {usage.popoverHtml && (
                                            <button
                                                type="button"
                                                class={`artifact-set-usage-preview character-rarity-${usage.characterRarity}`}
                                                data-usage-preview
                                                aria-expanded="false"
                                                aria-label={`${previewLabel}: ${usage.characterName}`}
                                            >
                                                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                                                    <circle cx="8" cy="8" r="6.2" />
                                                    <path d="M8 7.2v4" />
                                                    <path d="M8 4.7v.1" />
                                                </svg>
                                            </button>
                                        )}
                                    </span>
                                ))}
                            </div>
                        ) : (
                            <p class="artifact-set-usage-empty">
                                {noMentionsLabel}
                            </p>
                        )}
                    </section>

                    <section class="relic-owned">
                        <h3>{ui('Roster owned usage')}</h3>
                        <div data-relic-owned></div>
                    </section>
                </article>
            ))
        }
    </div>

    <p class="artifact-set-empty" data-relic-empty hidden>
        {noResultsLabel}
    </p>
</section>

<script>
    import '../scripts/card-filters';
    import '../scripts/relic-usage-popover';
    import '../scripts/relic-roster';
</script>
